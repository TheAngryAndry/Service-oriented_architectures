# Publish only the homework submission; keep conditions and helpers local.
/*
!/.gitignore
!/.dockerignore
!/README.md
!/Dockerfile
!/docker-compose.yml
!/services/
!/docs/

/services/*
!/services/orders/
/services/orders/*
!/services/orders/Cargo.toml
!/services/orders/Cargo.lock
!/services/orders/build.rs
!/services/orders/src/
!/services/orders/openapi/
!/services/orders/migrations/

/docs/*
!/docs/architecture/
/docs/architecture/*
!/docs/architecture/container.png

# Generated OpenAPI DTOs/routes and other build output stay local.
**/target/
**/__pycache__/
.env
.env.*
*.log
.DS_Store
