# Only submission files are tracked; local notes stay on disk.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/Dockerfile
!/docker-compose.yml
!/services/
!/scripts/
!/tests/

/services/*
!/services/orders/
/services/orders/*
!/services/orders/Cargo.toml
!/services/orders/Cargo.lock
!/services/orders/build.rs
!/services/orders/src/
!/services/orders/openapi/
!/services/orders/migrations/

/scripts/*
!/scripts/generate-api.sh
!/scripts/demo.py
!/scripts/check-logs.py
!/scripts/smoke-test.sh
!/scripts/test.sh

/tests/*
!/tests/Dockerfile
!/tests/e2e.py

# Build output includes all generated OpenAPI DTOs and routes.
**/target/
**/__pycache__/
.env
.env.*
!/.env.example
*.log
.DS_Store
