# Only submission files are tracked; local notes stay on disk.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/Dockerfile
!/docker-compose.yml
!/services/
!/.cargo/
!/tools/
!/tests/

/services/*
!/services/orders/
/services/orders/*
!/services/orders/Cargo.toml
!/services/orders/Cargo.lock
!/services/orders/build.rs
!/services/orders/src/
!/services/orders/openapi/
!/services/orders/migrations/

/.cargo/*
!/.cargo/config.toml

/tools/*
!/tools/Cargo.toml
!/tools/Cargo.lock
!/tools/src/
!/tools/tests/

/tests/*
!/tests/Dockerfile

# Build output includes all generated OpenAPI DTOs and routes.
**/target/
**/__pycache__/
.env
.env.*
!/.env.example
*.log
.DS_Store
