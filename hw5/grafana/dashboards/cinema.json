    {
      "id": 2,
      "title": "DAU and conversion",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT date,maxIf(value,metric='dau') AS DAU,maxIf(value,metric='conversion') AS Conversion,maxIf(value,metric='avg_watch_seconds') AS AverageSeconds FROM daily_metrics FINAL GROUP BY date ORDER BY date DESC",
          "format": 1
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Top movies by started views",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT date,dimension AS Movie,value AS Views FROM daily_metrics FINAL WHERE metric='movie_views' ORDER BY date DESC,Views DESC LIMIT 100",
          "format": 1
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
