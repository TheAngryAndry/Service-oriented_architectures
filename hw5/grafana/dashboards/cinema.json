  "panels": [
    {
      "id": 1,
      "title": "Retention Cohort Heatmap",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "editorType": "sql",
          "rawSql": "SELECT date AS Cohort,maxOrNullIf(value,metric='retention_d0') AS \"Day 0\",maxOrNullIf(value,metric='retention_d1') AS \"Day 1\",maxOrNullIf(value,metric='retention_d2') AS \"Day 2\",maxOrNullIf(value,metric='retention_d3') AS \"Day 3\",maxOrNullIf(value,metric='retention_d4') AS \"Day 4\",maxOrNullIf(value,metric='retention_d5') AS \"Day 5\",maxOrNullIf(value,metric='retention_d6') AS \"Day 6\",maxOrNullIf(value,metric='retention_d7') AS \"Day 7\" FROM daily_metrics FINAL WHERE startsWith(metric,'retention_d') GROUP BY date HAVING maxIf(value,metric='retention_d0')>0 ORDER BY date DESC",
          "format": 1
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Day 0"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
